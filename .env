# ============================================================================
#  SCM Platform — environment template
#  Copy to `.env` and edit. Used by `docker compose` automatically.
# ============================================================================

# ───── Profile selector ─────
# `local`  → starts postgres / kafka / redis / prometheus / grafana inside Docker
# (leave empty)  → cloud mode, you must use docker-compose.aws.yml overlay
COMPOSE_PROFILES=local

# ───── Frontend ─────
# Browser-facing API URL. Local: http://localhost:7080
# AWS:    https://api.your-domain.com  (ALB + ACM cert)
API_BASE_URL=http://localhost:7080

# ───── Auth / JWT ─────
# Must be the SAME value in api-gateway and auth-service.
# In AWS, store this in Secrets Manager and inject via task definition.
JWT_SECRET=logisticsSecretKeyForJwtMustBeLongEnough123456789

# ───── Database ─────
# LOCAL  : leave the docker-compose defaults (postgres container).
# AWS    : point at RDS, e.g. jdbc:postgresql://scm.xxxxx.us-east-1.rds.amazonaws.com:5432/<db>
#          and set the same user/password as your RDS master.
DB_USERNAME=admin
DB_PASSWORD=password

# ───── Kafka ─────
# LOCAL : kafka:29092
# AWS   : MSK bootstrap brokers, e.g. b-1.xxx.kafka.us-east-1.amazonaws.com:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ───── Mail (notification-service) ─────
# LOCAL : Gmail SMTP (works with an app password)
# AWS   : Amazon SES SMTP — host email-smtp.us-east-1.amazonaws.com, port 587
MAIL_USERNAME=Adhams.Botmail@gmail.com
MAIL_PASSWORD=tkfp vsuh kybi jwbh

# ───── Eureka ─────
# Set EUREKA_CLIENT_ENABLED=false to disable service discovery entirely
# (e.g. on ECS where Service Connect handles DNS).
EUREKA_CLIENT_ENABLED=true


ADMIN_BOOTSTRAP_EMAIL=adham@gmail.com
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=P@ssw0rd

