@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

title SCM Platform - Use Case (Operations and Fulfillment)

actor "Inventory Manager" as InventoryManager
actor "Warehouse Operator" as WarehouseOperator
actor "Shipment Manager" as ShipmentManager

rectangle "SCM Platform" {
  usecase "Reserve Stock" as UC_Reserve
  usecase "Adjust Inventory" as UC_Adjust
  usecase "Create Picking Task" as UC_PickCreate
  usecase "Pick and Pack" as UC_PickPack
  usecase "Create Shipment" as UC_ShipCreate
  usecase "Dispatch Shipment" as UC_Dispatch
  usecase "Update Tracking" as UC_Tracking
}

InventoryManager --> UC_Reserve
InventoryManager --> UC_Adjust

WarehouseOperator --> UC_PickCreate
WarehouseOperator --> UC_PickPack

ShipmentManager --> UC_ShipCreate
ShipmentManager --> UC_Dispatch
ShipmentManager --> UC_Tracking

UC_PickPack .> UC_ShipCreate : <<include>>
UC_Dispatch .> UC_Tracking : <<include>>
UC_Reserve .> UC_PickCreate : <<include>>

@enduml

