@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

title SCM Platform - Use Case (Customer Commerce Flow)

actor Customer
actor "API Gateway" as Gateway

rectangle "SCM Platform" {
  usecase "Register/Login" as UC_Login
  usecase "Manage Cart" as UC_Cart
  usecase "Browse Inventory" as UC_Browse
  usecase "Place Order" as UC_Order
  usecase "Track Shipment" as UC_Track
  usecase "Download Invoice" as UC_Invoice
  usecase "Receive Notifications" as UC_Notify
}

Customer --> UC_Login
Customer --> UC_Browse
Customer --> UC_Cart
Customer --> UC_Order
Customer --> UC_Track
Customer --> UC_Invoice
Customer --> UC_Notify

Gateway --> UC_Login
Gateway --> UC_Cart
Gateway --> UC_Order
Gateway --> UC_Track
Gateway --> UC_Invoice

UC_Order .> UC_Cart : <<include>>
UC_Order .> UC_Browse : <<include>>
UC_Track .> UC_Notify : <<extend>>

@enduml

