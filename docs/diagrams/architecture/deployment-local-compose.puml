@startuml
skinparam shadowing false

title SCM Platform - Local Deployment (Docker Compose)

node "Developer Machine" {
  node "Docker Network" {
    [dashboard:80]
    [api-gateway:7080]
    [discovery-server:8761]

    [auth-service:8081]
    [order-service:2501]
    [inventory-service:2502]
    [shipment-service:2503]
    [warehouse-service:2504]
    [notification-service:2505]
    [cart-service:8083]
    [document-gen-service:3050]

    [postgres:5432]
    [kafka:9092/29092]
    [zookeeper:2181]

    [kafka-exporter:9308]
    [prometheus:9090]
    [grafana:3000]
  }
}

[dashboard:80] --> [api-gateway:7080]
[api-gateway:7080] --> [auth-service:8081]
[api-gateway:7080] --> [order-service:2501]
[api-gateway:7080] --> [inventory-service:2502]
[api-gateway:7080] --> [shipment-service:2503]
[api-gateway:7080] --> [warehouse-service:2504]

[order-service:2501] --> [kafka:9092/29092]
[shipment-service:2503] --> [kafka:9092/29092]
[notification-service:2505] --> [kafka:9092/29092]

[prometheus:9090] --> [kafka-exporter:9308]
[prometheus:9090] --> [kafka:9092/29092] : JMX 7071
[grafana:3000] --> [prometheus:9090]

@enduml

