@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
autonumber

title SCM Platform - Sequence (Cart Checkout to Order Creation)

actor Customer
participant Frontend
participant "API Gateway" as Gateway
participant "Cart Service" as CartSvc
participant "Order Service" as OrderSvc
participant "Inventory Service" as InventorySvc
participant "Warehouse Service" as WarehouseSvc
queue "Kafka: order-created-topic" as T_OrderCreated

Customer -> Frontend : Click Checkout
Frontend -> Gateway : POST /api/carts/{id}/checkout
Gateway -> CartSvc : loadActiveCart(customerId)
CartSvc --> Gateway : cart items
Gateway -> OrderSvc : createOrderFromCart(cart)
OrderSvc -> InventorySvc : reserveStock(items)

alt reservation success
  InventorySvc --> OrderSvc : reserved OK
  OrderSvc -> WarehouseSvc : createPickingTask(orderId)
  WarehouseSvc --> OrderSvc : taskId
  OrderSvc -> T_OrderCreated : publish OrderCreatedEvent
  OrderSvc --> Gateway : 201 order created
  Gateway --> Frontend : order number + status
else reservation failed
  InventorySvc --> OrderSvc : OUT_OF_STOCK
  OrderSvc --> Gateway : 409 conflict
  Gateway --> Frontend : show unavailable items
end

@enduml

