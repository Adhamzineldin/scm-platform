@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
autonumber

title SCM Platform - Sequence (Document Generation and Download)

actor Customer
participant Frontend
participant "API Gateway" as Gateway
participant "Document Gen Service" as DocSvc
participant "Order Service" as OrderSvc
participant "Shipment Service" as ShipmentSvc
database "Document Storage" as Storage

Customer -> Frontend : Request invoice / label
Frontend -> Gateway : POST /api/documents/generate
Gateway -> DocSvc : generate(orderId, type)
DocSvc -> OrderSvc : getOrder(orderId)
OrderSvc --> DocSvc : order data
DocSvc -> ShipmentSvc : getShipment(orderId)
ShipmentSvc --> DocSvc : tracking data
DocSvc -> DocSvc : render template as PDF
DocSvc -> Storage : save PDF blob
Storage --> DocSvc : documentId + url
DocSvc --> Gateway : 201 document metadata
Gateway --> Frontend : download link

Customer -> Frontend : Download document
Frontend -> Gateway : GET /api/documents/{id}
Gateway -> DocSvc : fetchDocument(id)
DocSvc -> Storage : read blob
Storage --> DocSvc : PDF bytes
DocSvc --> Gateway : application/pdf
Gateway --> Frontend : PDF stream

@enduml

