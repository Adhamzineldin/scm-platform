@startuml
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho

title SCM Platform - Microservice Collaboration Diagram

actor "Customer / Staff" as User

package "Edge Layer" {
  [Frontend (React)] as Frontend
  [API Gateway] as Gateway
}

package "Core Platform Services" {
  [Auth Service] as Auth
  [Order Service] as Order
  [Inventory Service] as Inventory
  [Warehouse Service] as Warehouse
  [Shipment Service] as Shipment
  [Cart Service] as Cart
  [Document Gen Service] as DocGen
  [Notification Service] as Notification
  [Discovery Server] as Discovery
}

queue "Kafka Broker" as Kafka
database "PostgreSQL" as Postgres
cloud "SMTP Provider" as SMTP

User --> Frontend : UI actions
Frontend --> Gateway : HTTPS /api/*

Gateway --> Auth : /api/auth/**
Gateway --> Order : /api/orders/**
Gateway --> Inventory : /api/inventory/**
Gateway --> Warehouse : /api/warehouse/**
Gateway --> Shipment : /api/shipments/**
Gateway --> Cart : /api/carts/**
Gateway --> DocGen : /api/documents/**
Gateway --> Notification : /api/notifications/**

Auth --> Discovery : register + lookup
Order --> Discovery : register + lookup
Inventory --> Discovery : register + lookup
Warehouse --> Discovery : register + lookup
Shipment --> Discovery : register + lookup
Cart --> Discovery : register + lookup
DocGen --> Discovery : register + lookup
Notification --> Discovery : register + lookup
Gateway --> Discovery : service resolution

Order --> Inventory : reserve/release stock
Order --> Warehouse : create picking task
Order --> Shipment : create shipment request

Order -> Kafka : order-created-topic
Order -> Kafka : order-status-changed-topic
Warehouse -> Kafka : warehouse-order-packed
Shipment -> Kafka : shipment-dispatched-topic
Kafka --> Notification : consume domain events
Notification --> SMTP : send emails

Auth --> Postgres
Order --> Postgres
Inventory --> Postgres
Warehouse --> Postgres
Shipment --> Postgres
Cart --> Postgres

@enduml

